{
  "permissions": {
    "allow": [
      "mcp__salesforce-docs__*",
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Agent",
      "Skill"
    ],
    "deny": [
      "Bash(rm -rf orgs*)",
      "Bash(rm -r orgs*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /Users/*)",
      "Bash(rm -rf /c/Users/*)",
      "Bash(rm -rf C:\\Users\\*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/.sf*)",
      "Bash(rm -rf .sf*)",
      "Bash(sf org delete*)",
      "Bash(sf org logout --all*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  },
  "showThinkingSummaries": true,
  "env": {
    "SF_DISABLE_PLUGIN_MATCH": "1"
  }
}
